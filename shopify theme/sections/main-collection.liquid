<section class="page-shell" data-testid="boutique-page">
  <canvas class="starfield" data-starfield data-density="60"></canvas>
  <div class="page-shell__inner page-shell__inner--wide">
    <div class="section__header reveal">
      <p class="eyebrow eyebrow--center">La boutique</p>
      <h1>Collection Instant Céleste</h1>
      <p>Votre ciel exact, à la date et au lieu qui comptent, transformé en affiche d'art dorée et personnalisée. Choisissez votre visuel, votre taille, votre cadre — nous créons et expédions votre affiche sous 4 à 12 jours ouvrés.</p>
    </div>

    <div class="product-grid">
      {% render 'product-card', handle: 'aurore-boreale', title: 'Aurore Boréale', tagline: 'Une aurore rien qu’à vous', poster_asset: 'poster-aurore.jpg' %}
      {% render 'product-card', handle: 'nuages-roses', title: 'Nuages Roses', tagline: 'La douceur d’un ciel d’aube', poster_asset: 'poster-nuages.jpg' %}
      {% render 'product-card', handle: 'etoiles-celestes', title: 'Étoiles Célestes', tagline: 'Un ciel d’été infini', poster_asset: 'poster-etoiles-celestes.jpg' %}
      {% render 'product-card', handle: 'voie-lactee', title: 'Voie Lactée', tagline: 'La voie lactée en majesté', poster_asset: 'poster-voie-lactee.jpg' %}
      {% render 'product-card', handle: 'etoiles-filantes', title: 'Étoiles Filantes', tagline: 'Une pluie de vœux', poster_asset: 'poster-etoiles.jpg' %}
    </div>

    <p class="collection-note reveal" data-testid="collection-note">Prix TTC selon la configuration TVA de Shopify · Cadre noir ou blanc inclus · Cadre chêne +7,90 € · Livraison offerte si configurée · Satisfait ou remplacé</p>
  </div>
</section>

{% schema %}
{
  "name": "Boutique Instant Céleste",
  "settings": []
}
{% endschema %}
