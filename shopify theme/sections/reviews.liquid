<section class="section section--narrow" data-testid="reviews-section">
  <div class="section__header reveal">
    <p class="eyebrow eyebrow--center">Ils nous confient leurs étoiles</p>
    <h2>Avis clients</h2>
  </div>
  <div class="card reviews-empty reveal" data-testid="reviews-empty-state">
    <div class="review-stars" aria-hidden="true">
      {% for i in (1..5) %}{% render 'icon', name: 'star', size: 20 %}{% endfor %}
    </div>
    <p>Les avis de nos premiers clients apparaîtront ici, en toute transparence, dès l'ouverture de la boutique.</p>
    <span>Aucun avis publié pour le moment</span>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": []
}
{% endschema %}
