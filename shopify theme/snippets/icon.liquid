{%- assign icon_size = size | default: 18 -%}
<svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'sparkles' -%}
      <path d="M12 3l1.7 5.1L19 10l-5.3 1.9L12 17l-1.7-5.1L5 10l5.3-1.9L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    {%- when 'bag' -%}
      <path d="M6 8h12l1 13H5L6 8z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>
    {%- when 'menu' -%}
      <path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12"/><path d="M18 6L6 18"/>
    {%- when 'pen' -%}
      <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
    {%- when 'package' -%}
      <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>
    {%- when 'shield' -%}
      <path d="M12 22s8-3 8-10V5l-8-3-8 3v7c0 7 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'award' -%}
      <circle cx="12" cy="8" r="6"/><path d="M8.2 13.9L7 22l5-3 5 3-1.2-8.1"/>
    {%- when 'star' -%}
      <path d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.3l7.1-.7L12 2z"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    {%- when 'check' -%}
      <path d="M20 6L9 17l-5-5"/>
    {%- when 'paint' -%}
      <path d="M12 22a10 10 0 1 1 10-10c0 2.8-2.2 5-5 5h-2a2 2 0 0 0-2 2c0 .5.2 1 .5 1.3.3.4.5.8.5 1.2 0 .3-.4.5-1 .5z"/><circle cx="7.5" cy="10.5" r=".5"/><circle cx="10.5" cy="7.5" r=".5"/><circle cx="15" cy="7" r=".5"/><circle cx="17.5" cy="10" r=".5"/>
    {%- when 'truck' -%}
      <path d="M1 5h14v12H1z"/><path d="M15 9h4l4 4v4h-8z"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/>
    {%- when 'send' -%}
      <path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'plus' -%}
      <path d="M12 5v14"/><path d="M5 12h14"/>
    {%- when 'trash' -%}
      <path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 15H6L5 6"/>
    {%- when 'lock' -%}
      <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
