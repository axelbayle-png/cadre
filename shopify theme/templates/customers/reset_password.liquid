<section class="page-shell" data-testid="reset-password-page">
  <canvas class="starfield" data-starfield data-density="50"></canvas>
  <div class="page-shell__inner page-shell__inner--narrow">
    <div class="section__header reveal">
      <p class="eyebrow eyebrow--center">Compte client</p>
      <h1>Réinitialiser le mot de passe</h1>
    </div>
    <div class="card page-content reveal">
      {% form 'reset_customer_password' %}
        {{ form.errors | default_errors }}
        <label class="lbl" for="ResetPassword">Nouveau mot de passe</label>
        <input class="field" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required data-testid="reset-password-input">
        <label class="lbl" for="ResetPasswordConfirmation">Confirmation</label>
        <input class="field" id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required data-testid="reset-password-confirm-input">
        <button class="btn btn--gold btn--full" type="submit" data-testid="reset-password-button">Enregistrer</button>
      {% endform %}
    </div>
  </div>
</section>
